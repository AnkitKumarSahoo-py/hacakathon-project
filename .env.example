# =============================================================================
# Smart Coach Guardian — Live Railway Data Configuration
# =============================================================================
# To switch from DEMO data to REAL live train data you need an API key from a
# train data provider. Copy this file to `.env` and fill in your key.

# >>> INSERT YOUR REAL TRAIN API KEY HERE <<<
# Get a free key at https://indianrailapi.com (supports live train status,
# train route, spot-my-train and PNR APIs).
IRCTC_API_KEY=

# Optional: base URL of your provider (leave default for indianrailapi.com)
IRCTC_API_BASE_URL=http://indianrailapi.com/api/v2

# Optional: port for the backend API server
API_PORT=8787